{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "build",
      "command": "dotnet",
      "type": "process",
      "args": [
        "build",
        "${workspaceFolder}/ChaiIdle/ChaiIdle.csproj"
      ],
      "problemMatcher": "$msbuild"
    },
    {
      "label": "run",
      "command": "dotnet",
      "type": "process",
      "args": [
        "run",
        "--project",
        "${workspaceFolder}/ChaiIdle/ChaiIdle.csproj"
      ],
      "problemMatcher": "$msbuild",
      "dependsOn": ["build"]
    }
  ]
}