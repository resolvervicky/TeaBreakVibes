<Window x:Class="ChaiIdle.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ChaiIdle — Settings"
        Width="460" Height="640"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize">

    <Window.Resources>
        <!-- Slider style -->
        <Style x:Key="ModernSlider" TargetType="Slider">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid>
                            <Track x:Name="PART_Track">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="Slider.DecreaseLarge" Focusable="False">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Border Height="4" CornerRadius="2">
                                                    <Border.Background>
                                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                                            <GradientStop Color="#FFFF8C00" Offset="0"/>
                                                            <GradientStop Color="#FFFF5200" Offset="1"/>
                                                        </LinearGradientBrush>
                                                    </Border.Background>
                                                </Border>
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.DecreaseRepeatButton>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="Slider.IncreaseLarge" Focusable="False">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Border Height="4" CornerRadius="2" Background="#30FFFFFF"/>
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.IncreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb>
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Ellipse Width="18" Height="18" Cursor="Hand">
                                                    <Ellipse.Fill>
                                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                            <GradientStop Color="#FFFF8C00" Offset="0"/>
                                                            <GradientStop Color="#FFFF4400" Offset="1"/>
                                                        </LinearGradientBrush>
                                                    </Ellipse.Fill>
                                                    <Ellipse.Effect>
                                                        <DropShadowEffect BlurRadius="8" Color="#FFFF6600" Opacity="0.6" ShadowDepth="0"/>
                                                    </Ellipse.Effect>
                                                </Ellipse>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ComboBox style -->
        <ControlTemplate x:Key="ModernComboTemplate" TargetType="ComboBox">
            <Grid>
                <Border x:Name="Border" CornerRadius="10" BorderThickness="1"
                        Background="#20FFFFFF">
                    <Border.BorderBrush>
                        <SolidColorBrush Color="#40FFFFFF"/>
                    </Border.BorderBrush>
                    <Grid>
                        <ContentPresenter x:Name="ContentSite" IsHitTestVisible="False"
                                          Content="{TemplateBinding SelectionBoxItem}"
                                          ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                          Margin="14,10,36,10" VerticalAlignment="Center"/>
                        <TextBlock Text="▾" Foreground="#80FFFFFF" FontSize="16"
                                   HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,14,0"/>
                        <ToggleButton x:Name="ToggleButton"
                                      Background="Transparent" BorderThickness="0"
                                      IsChecked="{Binding Path=IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                      Focusable="False" ClickMode="Press">
                            <ToggleButton.Template>
                                <ControlTemplate TargetType="ToggleButton">
                                    <Border Background="Transparent"/>
                                </ControlTemplate>
                            </ToggleButton.Template>
                        </ToggleButton>
                    </Grid>
                </Border>
                <Popup x:Name="Popup" Placement="Bottom" IsOpen="{TemplateBinding IsDropDownOpen}"
                       AllowsTransparency="True" Focusable="False" PopupAnimation="Slide">
                    <Border CornerRadius="10" Margin="0,4,0,0" BorderThickness="1"
                            MinWidth="{TemplateBinding ActualWidth}">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                <GradientStop Color="#F0161616" Offset="0"/>
                                <GradientStop Color="#F0221A00" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.Background>
                        <Border.BorderBrush>
                            <SolidColorBrush Color="#50FF8C00"/>
                        </Border.BorderBrush>
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="20" Color="Black" Opacity="0.5" ShadowDepth="4"/>
                        </Border.Effect>
                        <ScrollViewer SnapsToDevicePixels="True">
                            <ItemsPresenter/>
                        </ScrollViewer>
                    </Border>
                </Popup>
            </Grid>
        </ControlTemplate>

        <Style x:Key="ModernComboBox" TargetType="ComboBox">
            <Setter Property="Template" Value="{StaticResource ModernComboTemplate}"/>
            <Setter Property="Foreground" Value="#FFFFFBE8"/>
            <Setter Property="FontSize" Value="14"/>
        </Style>

        <Style x:Key="ComboItemStyle" TargetType="ComboBoxItem">
            <Setter Property="Foreground" Value="#FFFFFBE8"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Padding" Value="14,10"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#25FF8C00"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#40FF8C00"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Primary button template -->
        <ControlTemplate x:Key="PrimaryBtn" TargetType="Button">
            <Border x:Name="Bd" CornerRadius="12">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                        <GradientStop Color="#FFFF8C00" Offset="0"/>
                        <GradientStop Color="#FFFF4400" Offset="1"/>
                    </LinearGradientBrush>
                </Border.Background>
                <Border.Effect>
                    <DropShadowEffect BlurRadius="16" Color="#FFFF6600" Opacity="0.45" ShadowDepth="0"/>
                </Border.Effect>
                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,12"/>
            </Border>
            <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter TargetName="Bd" Property="Opacity" Value="0.88"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter TargetName="Bd" Property="Opacity" Value="0.7"/>
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>

        <!-- Ghost button template -->
        <ControlTemplate x:Key="GhostBtn" TargetType="Button">
            <Border x:Name="Bd" CornerRadius="12" BorderThickness="1" Background="Transparent">
                <Border.BorderBrush>
                    <SolidColorBrush Color="#50FF8C00"/>
                </Border.BorderBrush>
                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,12"/>
            </Border>
            <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter TargetName="Bd" Property="Background" Value="#15FF8C00"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter TargetName="Bd" Property="Background" Value="#30FF8C00"/>
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>
    </Window.Resources>

    <!-- Root -->
    <Border Margin="20" CornerRadius="28">
        <Border.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#F5111111" Offset="0"/>
                <GradientStop Color="#F5201400" Offset="1"/>
            </LinearGradientBrush>
        </Border.Background>
        <Border.Effect>
            <DropShadowEffect BlurRadius="40" Color="Black" Opacity="0.6" ShadowDepth="0"/>
        </Border.Effect>
        <Border CornerRadius="26" BorderThickness="1">
            <Border.BorderBrush>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#50FFFFFF" Offset="0"/>
                    <GradientStop Color="#10FFFFFF" Offset="1"/>
                </LinearGradientBrush>
            </Border.BorderBrush>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Title Bar -->
                <Border Grid.Row="0" Padding="24,18,16,16" MouseDown="Window_MouseDown" Cursor="SizeAll">
                    <DockPanel>
                        <TextBlock Text="☕" FontSize="26" VerticalAlignment="Center" Margin="0,0,10,0"/>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="OruTeaDa" FontSize="18" FontWeight="Bold" Foreground="White"/>
                            <TextBlock Text="ChaiIdle Settings" FontSize="11" Foreground="#60FFFFFF"/>
                        </StackPanel>
                        <Button x:Name="BtnClose" DockPanel.Dock="Right" HorizontalAlignment="Right"
                                Content="✕" Cursor="Hand" Click="MinimizeToTray"
                                Width="32" Height="32" Padding="0"
                                Foreground="#80FFFFFF" Background="Transparent"
                                BorderBrush="Transparent" FontSize="14" FontWeight="Bold"/>
                    </DockPanel>
                </Border>

                <!-- Separator -->
                <Border Grid.Row="0" VerticalAlignment="Bottom" Height="1" Margin="20,0">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                            <GradientStop Color="#40FF8C00" Offset="0"/>
                            <GradientStop Color="Transparent" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.Background>
                </Border>

                <!-- Content -->
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Hidden" Padding="24,20">
                    <StackPanel>

                        <!-- Status pill -->
                        <Border CornerRadius="20" Padding="14,8" Margin="0,0,0,24"
                                HorizontalAlignment="Left">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                    <GradientStop Color="#30FF8C00" Offset="0"/>
                                    <GradientStop Color="#10FF8C00" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Width="8" Height="8" Fill="#FFFF8C00" Margin="0,0,8,0"
                                         VerticalAlignment="Center">
                                    <Ellipse.Effect>
                                        <DropShadowEffect BlurRadius="6" Color="#FFFF8C00" Opacity="1" ShadowDepth="0"/>
                                    </Ellipse.Effect>
                                </Ellipse>
                                <TextBlock x:Name="StatusText" Text="Watching for idle..."
                                           Foreground="#FFFFD280" FontSize="12" FontWeight="SemiBold"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>

                        <!-- Idle time card -->
                        <Border CornerRadius="16" Padding="20" Margin="0,0,0,16"
                                Background="#12FFFFFF" BorderThickness="1">
                            <Border.BorderBrush>
                                <SolidColorBrush Color="#20FFFFFF"/>
                            </Border.BorderBrush>
                            <StackPanel>
                                <DockPanel Margin="0,0,0,14">
                                    <TextBlock Text="⏱  Idle Threshold" Foreground="#FFFFD280"
                                               FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                    <Border DockPanel.Dock="Right" CornerRadius="8" Padding="10,4"
                                            Background="#25FF8C00">
                                        <TextBlock x:Name="IdleMinutesLabel" Text="5 min"
                                                   Foreground="#FFFF8C00" FontSize="13" FontWeight="Bold"/>
                                    </Border>
                                </DockPanel>
                                <Slider x:Name="IdleSlider" Minimum="1" Maximum="30"
                                        TickFrequency="1" IsSnapToTickEnabled="True" Value="5"
                                        Style="{StaticResource ModernSlider}"
                                        ValueChanged="IdleSlider_ValueChanged"/>
                                <TextBlock Text="Chai appears after this many minutes of inactivity."
                                           Foreground="#40FFFFFF" FontSize="11" Margin="0,10,0,0"/>
                            </StackPanel>
                        </Border>

                        <!-- Language card -->
                        <Border CornerRadius="16" Padding="20" Margin="0,0,0,16"
                                Background="#12FFFFFF" BorderThickness="1">
                            <Border.BorderBrush>
                                <SolidColorBrush Color="#20FFFFFF"/>
                            </Border.BorderBrush>
                            <StackPanel>
                                <TextBlock Text="🌍  Dialogue Language" Foreground="#FFFFD280"
                                           FontSize="13" FontWeight="SemiBold" Margin="0,0,0,12"/>
                                <ComboBox x:Name="LanguageCombo" Style="{StaticResource ModernComboBox}"
                                          ItemContainerStyle="{StaticResource ComboItemStyle}">
                                    <ComboBoxItem Content="Tamil"/>
                                    <ComboBoxItem Content="English"/>
                                    <ComboBoxItem Content="Hinglish"/>
                                    <ComboBoxItem Content="Telugu"/>
                                </ComboBox>
                            </StackPanel>
                        </Border>

                        <!-- Custom Audio card -->
                        <Border CornerRadius="16" Padding="20" Margin="0,0,0,16"
                                Background="#12FFFFFF" BorderThickness="1">
                            <Border.BorderBrush>
                                <SolidColorBrush Color="#20FFFFFF"/>
                            </Border.BorderBrush>
                            <StackPanel>
                                <DockPanel Margin="0,0,0,12">
                                    <TextBlock Text="🎙  Custom Audio" Foreground="#FFFFD280"
                                               FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="AudioStatus" Text="MP3, &lt;1MB"
                                               Foreground="#60FFFFFF" FontSize="11" 
                                               HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                </DockPanel>
                                <Button x:Name="BtnUploadAudio" Content="📁  Upload MP3" Cursor="Hand"
                                        Click="UploadAudio_Click" Template="{StaticResource GhostBtn}"
                                        Foreground="#FFFFD280" FontSize="12" FontWeight="SemiBold"/>
                                <TextBlock Text="Adds a new clip to your selected language folder."
                                           Foreground="#40FFFFFF" FontSize="10" Margin="0,10,0,0"/>
                            </StackPanel>
                        </Border>

                    </StackPanel>
                </ScrollViewer>

                <Border Grid.Row="2" Padding="24,16" BorderThickness="0,1,0,0">
                    <Border.BorderBrush>
                        <SolidColorBrush Color="#20FFFFFF"/>
                    </Border.BorderBrush>
                    <Button Content="Save &amp; Close" Cursor="Hand"
                            Click="SaveAndMinimize" Template="{StaticResource PrimaryBtn}"
                            Foreground="White" FontSize="14" FontWeight="Bold"/>
                </Border>
            </Grid>
        </Border>
    </Border>
</Window>
