<Window x:Class="ChaiIdle.OverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="OruTeaDa"
        AllowsTransparency="True"
        WindowStyle="None"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        SizeToContent="WidthAndHeight"
        WindowStartupLocation="CenterScreen">

    <Grid>
        <!-- Outer glow shell -->
        <Border x:Name="RootCard"
                Margin="20"
                CornerRadius="32"
                Opacity="0">
            <Border.Effect>
                <DropShadowEffect BlurRadius="60" Color="#FF8C00" Opacity="0.35" ShadowDepth="0"/>
            </Border.Effect>
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#F2161616" Offset="0"/>
                    <GradientStop Color="#F2221A00" Offset="1"/>
                </LinearGradientBrush>
            </Border.Background>

            <!-- Inner glass border -->
            <Border CornerRadius="30"
                    BorderThickness="1">
                <Border.BorderBrush>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#60FFFFFF" Offset="0"/>
                        <GradientStop Color="#10FFFFFF" Offset="1"/>
                    </LinearGradientBrush>
                </Border.BorderBrush>

                <StackPanel Width="520" Margin="40,36,40,36" HorizontalAlignment="Center">

                    <!-- Header row -->
                    <DockPanel Margin="0,0,0,24">
                        <TextBlock Text="☕" FontSize="22" VerticalAlignment="Center" Margin="0,0,10,0"/>
                        <TextBlock Text="OruTeaDa" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center"
                                   Foreground="#80FFFFFF"/>
                        <Button x:Name="CloseXButton" Content="✕" DockPanel.Dock="Right"
                                HorizontalAlignment="Right" VerticalAlignment="Center"
                                Click="CloseButton_Click" Cursor="Hand"
                                Width="32" Height="32" Padding="0"
                                FontSize="14" FontWeight="Bold"
                                Foreground="#80FFFFFF" Background="Transparent"
                                BorderBrush="Transparent" BorderThickness="0"/>
                    </DockPanel>

                    <!-- Animated Tea Cup (Phosphor Icons SVG) -->
                    <Grid Height="200" Margin="0,0,0,24" HorizontalAlignment="Center" Width="200">

                        <!-- Outer glow pulse ring -->
                        <Ellipse x:Name="GlowRing"
                                 Width="180" Height="180"
                                 HorizontalAlignment="Center" VerticalAlignment="Center"
                                 Stroke="#40FF8C00" StrokeThickness="2"
                                 Fill="Transparent">
                            <Ellipse.Effect>
                                <BlurEffect Radius="8"/>
                            </Ellipse.Effect>
                        </Ellipse>

                        <!-- Tea cup SVG (Phosphor Icons, viewBox 0 0 256 256) -->
                        <Viewbox Width="140" Height="140"
                                 HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Canvas Width="256" Height="256">
                                <Path x:Name="CupPath"
                                      Data="M80,56V24a8,8,0,0,1,16,0V56a8,8,0,0,1-16,0Zm40,8a8,8,0,0,0,8-8V24a8,8,0,0,0-16,0V56A8,8,0,0,0,120,64Zm32,0a8,8,0,0,0,8-8V24a8,8,0,0,0-16,0V56A8,8,0,0,0,152,64Zm96,56v8a40,40,0,0,1-37.51,39.91,96.59,96.59,0,0,1-27,40.09H208a8,8,0,0,1,0,16H32a8,8,0,0,1,0-16H56.54A96.3,96.3,0,0,1,24,136V88a8,8,0,0,1,8-8H208A40,40,0,0,1,248,120ZM200,96H40v40a80.27,80.27,0,0,0,45.12,72h69.76A80.27,80.27,0,0,0,200,136Zm32,24a24,24,0,0,0-16-22.62V136a95.78,95.78,0,0,1-1.2,15A24,24,0,0,0,232,128Z">
                                    <Path.Fill>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                            <GradientStop Color="#FFFF9A3C" Offset="0"/>
                                            <GradientStop Color="#FFFF5500" Offset="1"/>
                                        </LinearGradientBrush>
                                    </Path.Fill>
                                    <Path.Effect>
                                        <DropShadowEffect BlurRadius="18" Color="#FFFF7700"
                                                          Opacity="0.7" ShadowDepth="0"/>
                                    </Path.Effect>
                                </Path>
                            </Canvas>
                        </Viewbox>

                        <!-- Steam particles -->
                        <Canvas Width="200" Height="200" IsHitTestVisible="False">
                            <Ellipse x:Name="Steam1" Width="8" Height="8"
                                     Fill="#50FFFFFF" Canvas.Left="76" Canvas.Top="28" Opacity="0">
                                <Ellipse.Effect><BlurEffect Radius="4"/></Ellipse.Effect>
                            </Ellipse>
                            <Ellipse x:Name="Steam2" Width="6" Height="6"
                                     Fill="#40FFFFFF" Canvas.Left="96" Canvas.Top="22" Opacity="0">
                                <Ellipse.Effect><BlurEffect Radius="3"/></Ellipse.Effect>
                            </Ellipse>
                            <Ellipse x:Name="Steam3" Width="10" Height="10"
                                     Fill="#35FFFFFF" Canvas.Left="112" Canvas.Top="30" Opacity="0">
                                <Ellipse.Effect><BlurEffect Radius="5"/></Ellipse.Effect>
                            </Ellipse>
                        </Canvas>

                        <!-- Ripple ring at bottom of cup -->
                        <Ellipse x:Name="RippleEllipse" Width="40" Height="10"
                                 Margin="0,160,0,0" VerticalAlignment="Top"
                                 HorizontalAlignment="Center"
                                 Stroke="#30FFAA44" StrokeThickness="1.5"
                                 Fill="Transparent" Opacity="0"/>
                    </Grid>

                    <!-- Dialogue Glass Card -->
                    <Border x:Name="DialogueCard"
                            Padding="28,20"
                            CornerRadius="18"
                            Margin="0,0,0,24"
                            Opacity="0">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#20FFFFFF" Offset="0"/>
                                <GradientStop Color="#10FFFFFF" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.Background>
                        <Border.BorderBrush>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#50FFFFFF" Offset="0"/>
                                <GradientStop Color="#10FF8C00" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.BorderBrush>
                        <Border.BorderThickness>
                            <Thickness Left="1" Top="1" Right="0.5" Bottom="0.5"/>
                        </Border.BorderThickness>
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="20" Color="#FF8C00" Opacity="0.15" ShadowDepth="0"/>
                        </Border.Effect>

                        <TextBlock x:Name="DialogueText"
                                   FontSize="22"
                                   FontWeight="SemiBold"
                                   TextAlignment="Center"
                                   TextWrapping="Wrap"
                                   LineHeight="32">
                            <TextBlock.Foreground>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                    <GradientStop Color="#FFFFD280" Offset="0"/>
                                    <GradientStop Color="#FFFFA040" Offset="1"/>
                                </LinearGradientBrush>
                            </TextBlock.Foreground>
                        </TextBlock>
                    </Border>

                    <!-- Progress bar / Countdown -->
                    <Grid Margin="0,0,0,24" Opacity="0" x:Name="ProgressRow">
                        <Border Height="4" CornerRadius="2" Background="#20FFFFFF"/>
                        <Border x:Name="ProgressBar" Height="4" CornerRadius="2" HorizontalAlignment="Left">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                    <GradientStop Color="#FFFF8C00" Offset="0"/>
                                    <GradientStop Color="#FFFF3C00" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>
                        </Border>
                    </Grid>

                    <!-- Done button -->
                    <Button x:Name="CloseButton"
                            Click="CloseButton_Click"
                            Cursor="Hand"
                            Opacity="0"
                            Padding="0,14"
                            BorderThickness="0">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="Btn" CornerRadius="14" Padding="0,14">
                                    <Border.Background>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                            <GradientStop Color="#FFFF8C00" Offset="0"/>
                                            <GradientStop Color="#FFFF5200" Offset="1"/>
                                        </LinearGradientBrush>
                                    </Border.Background>
                                    <Border.Effect>
                                        <DropShadowEffect BlurRadius="20" Color="#FFFF6600" Opacity="0.5" ShadowDepth="0"/>
                                    </Border.Effect>
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Btn" Property="Opacity" Value="0.85"/>
                                    </Trigger>
                                    <Trigger Property="IsPressed" Value="True">
                                        <Setter TargetName="Btn" Property="Opacity" Value="0.7"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="✓ " FontSize="15" Foreground="White" FontWeight="Bold"/>
                            <TextBlock Text="Done with Chai" FontSize="15" Foreground="White" FontWeight="Bold"/>
                        </StackPanel>
                    </Button>

                </StackPanel>
            </Border>
        </Border>
    </Grid>
</Window>
