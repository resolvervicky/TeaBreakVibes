<Window x:Class="ChaiIdle.OverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:gif="clr-namespace:WpfAnimatedGif;assembly=WpfAnimatedGif"
        Title="OruTeaDa"
        AllowsTransparency="True"
        WindowStyle="None"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        SizeToContent="WidthAndHeight"
        WindowStartupLocation="CenterScreen">
    
    <Grid Background="Transparent">
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="20">
            <!-- Animation Container -->
            <Border Width="800" Height="450" Background="{x:Null}" Margin="0,0,0,20">
                <Image x:Name="AnimationImage" 
                       Width="800" Height="450"
                       RenderOptions.BitmapScalingMode="HighQuality"
                       gif:ImageBehavior.AnimateInDesignMode="True"
                       Stretch="Uniform"
                       ImageFailed="AnimationImage_ImageFailed"/>
            </Border>
            
            <!-- Dialogue Text -->
            <TextBlock x:Name="DialogueText"
                      FontSize="24"
                      FontWeight="Bold"
                      TextAlignment="Center"
                      TextWrapping="Wrap"
                      MaxWidth="800"
                      Margin="0,0,0,30"
                      Opacity="0">
                <TextBlock.Foreground>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#8B4513" Offset="0.0" />
                        <GradientStop Color="#D2691E" Offset="1.0" />
                    </LinearGradientBrush>
                </TextBlock.Foreground>
            </TextBlock>
            
            <!-- Close Button -->
            <Button x:Name="CloseButton"
                   Content="✕ Done with Chai"
                   Click="CloseButton_Click"
                   Padding="20,10"
                   FontSize="14"
                   Background="#FFD700"
                   Foreground="#8B4513"
                   FontWeight="Bold"
                   Cursor="Hand"
                   Opacity="0"/>
        </StackPanel>
    </Grid>
</Window>
